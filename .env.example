# looot agent token for real runs. Not needed for --demo or --dry-run. Create it in your looot settings, Agent tokens.
LOOOT_TOKEN=
# Optional variables are commented out because an empty value would override the default. Uncomment and fill one to use it.
# Optional: override the looot API base URL. Default https://api.looot.ai
# LOOOT_API_URL=

# Optional LinkedIn sender through your own Unipile account (paid third-party service).
# The sender stays off unless the DSN and API key are set, and sends nothing while outbox.dryRun is true.
# Unipile API host with port, from the Unipile dashboard.
# UNIPILE_DSN=
# Unipile API key, from the Unipile dashboard.
# UNIPILE_API_KEY=
# Connected LinkedIn account id, from the Unipile dashboard.
# UNIPILE_ACCOUNT_ID=
# Secret for the Unipile-Auth header on the webhook you register at /api/unipile/webhook.
# UNIPILE_WEBHOOK_SECRET=

# Optional LLM rewrite of message drafts. All three must be set. Off by default.
# Set to anthropic to switch it on.
# WARM_LLM=
# Anthropic API key.
# ANTHROPIC_API_KEY=
# Model name sent to the Anthropic API.
# WARM_LLM_MODEL=

# Where state is kept. Default .looot-warm
# WARM_DIR=
# Config file to use. Default: $WARM_DIR/config.json, then config/warm.config.json
# WARM_CONFIG=
# Set to 1 for sample data, no network (same as --demo).
# WARM_DEMO=
