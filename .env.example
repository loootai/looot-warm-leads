# looot key for real runs. Not needed for --demo or --dry-run. Create it in the looot dashboard.
LOOOT_TOKEN=

# Optional LinkedIn sender through your own Unipile account (paid third-party service).
# The sender stays off unless the first two are set, and sends nothing while outbox.dryRun is true.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
# Secret for the Unipile-Auth header on the webhook you register at /api/unipile/webhook.
UNIPILE_WEBHOOK_SECRET=

# Optional LLM rewrite of message drafts. All three must be set. Off by default.
WARM_LLM=
ANTHROPIC_API_KEY=
WARM_LLM_MODEL=

# Where state is kept (default .looot-warm) and which config file to use.
WARM_DIR=
WARM_CONFIG=
